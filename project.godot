; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3v3 Tactical FPS"
config/description="An original 3v3 tactical first-person shooter."
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameConfig="*res://scripts/core/game_config.gd"
NetworkManager="*res://scripts/network/network_manager.gd"
GameManager="*res://scripts/game/game_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

